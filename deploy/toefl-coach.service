# systemd user service. Install: see README "部署".
[Unit]
Description=TOEFL Coach web app
After=network-online.target

[Service]
WorkingDirectory=%h/TOEFL-Practice
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
