# Copy this file to .env and fill in the values. Never commit .env.

# Password for logging in from your phone. Use something long.
APP_PASSWORD=

# Claude API key from https://console.anthropic.com (Settings → API keys)
ANTHROPIC_API_KEY=

# Optional
# 出題與寫作批改用的模型
# ANTHROPIC_MODEL=claude-sonnet-5-5
# 單字表與單字卡用的模型（較便宜）
# ANTHROPIC_VOCAB_MODEL=claude-haiku-5-5
# PORT=3000
# HOST=127.0.0.1
# TZ_NAME=Asia/Taipei
