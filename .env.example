# Copy this file to .env and fill in the values. Never commit .env.

# Password for logging in from your phone. Use something long.
APP_PASSWORD=

# Claude API key from https://console.anthropic.com (Settings → API keys)
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-sonnet-5-5
# PORT=3000
# HOST=127.0.0.1
# TZ_NAME=Asia/Taipei
